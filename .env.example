# Copy this file to .env (which is git-ignored) to override defaults.

# Location of the SQLite database file. Relative paths are resolved from the
# repository root.
DATABASE_PATH=database/ecommerce.sqlite

# Port for the HTTP API.
PORT=3000

# Which model interprets questions: "openai" or "ollama".
# Defaults to openai when OPENAI_API_KEY is set, otherwise ollama.
LLM_PROVIDER=openai

# --- openai (also works with any OpenAI-compatible endpoint) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- ollama (local, no API key, nothing leaves the machine) ---
# OLLAMA_MODEL=qwen3.6
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# How long to wait for the model. Local models need more than hosted ones.
# LLM_TIMEOUT_MS=60000
